# Copy to .env.local; add real values there and in Vercel Environment Variables.
# SERVER ONLY. Never prefix credentials with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Dense Upstash Vector index. Hosted embedding models are detected automatically.
# Without one, OpenRouter generates vectors matching the index's dimensions.
# Use a read-only token on Vercel; a read/write token locally for ingestion.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
RAG_NAMESPACE=sreeved-portfolio
RAG_MIN_SCORE=0.5

# Upstash Redis for shared request limits (required; fails closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_REQUESTS_PER_MINUTE=10
CHAT_DAILY_REQUEST_LIMIT=200

# Extra browser origins, comma separated. No paths or trailing slash.
CHAT_ALLOWED_ORIGINS=https://sreevedvp.github.io

# PUBLIC URL only. Leave empty when the whole site runs on Vercel.
# For Pages: https://YOUR-PROJECT.vercel.app/api/chat
VITE_CHAT_API_URL=
